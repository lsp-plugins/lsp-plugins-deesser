<plugin resizable="true">
	<!-- Evaluate what kind of plugin we have -->
	<ui:eval id="is_sidechain" value="(ex :sc) or (ex :sc_l) or (ex :sc_r)"/>
	<ui:eval id="mono" value="ex :in"/>
	<ui:eval id="stereo" value="(ex :in_l) and (ex :in_r)" />

	<vbox>
		<!-- Top part -->
		<hbox hspacing="4" expand="true">
			<vbox expand="true">
				<group ui:inject="GraphGroup" ipadding="0" expand="true" fill="true" text="labels.graphs.spectrum">
					<graph width.min="680" height.min="350" expand="true" fill="true">
						<origin hpos="-1" vpos="-1" visible="false"/>
	
						<!-- Additional grid -->
						<ui:with color="graph_alt_1">
							<ui:for id="f" first="20" last="90" step="10">
								<marker v="${:f}"/>
								<marker v="${:f*10}"/>
								<marker v="${:f*100}"/>
							</ui:for>
							<marker v="20000"/>
							<ui:with ox="1" oy="0">
								<marker v="+12 db"/>
								<marker v="-12 db"/>
								<marker v="-36 db"/>
								<marker v="-60 db"/>
	
								<ui:for id="g" first="-42" last="6" step="12">
									<marker v="${g} db" visibility=":zoom le -9 db"/>
								</ui:for>
								<ui:for id="g" first="-21" last="3" step="6">
									<marker v="${g} db" visibility=":zoom le -15 db"/>
								</ui:for>
							</ui:with>
						</ui:with>
	
						<!-- Secondary grid -->
						<ui:with color="graph_sec">
							<marker v="100"/>
							<marker v="1000"/>
							<marker v="10000"/>
							<marker value="0 db" ox="1" oy="0"/>
							<marker value="-24 db" ox="1" oy="0"/>
							<marker value="-48 db" ox="1" oy="0"/>
						</ui:with>
	
						<!-- Piano keys -->
						<embed oy="4" start.x="midi_freq_start(12, 127)" start.y="20" end.x="midi_freq_end(12, 127)" end.y="44" valign="1" alpha="0" visibility=":_ui_graph_piano_layout">
							<piano natural="false" note.min="12" note.max="127" height="24" editable="false" selectable="false" border="0"/>
						</embed>
	
						<!-- Octave text -->
						<ui:with ox="0" oy="4" y="44" halign="1" valign="1" pgroup="0" priority="10" visibility=":_ui_graph_piano_layout" pad.b="2">
							<ui:for id="octave" first="0" last="9">
								<text x="midi_freq(12 * ${:octave + 1})" text="lists.notes.fmt.c" text:octave="${octave}" valign="1" halign="0"/>
							</ui:for>
						</ui:with>
	
						<!-- Band markers -->
						<ui:with
							width="2"
							fill="0.5"
							color.a="0.2"
							hcolor.a="0.8"
							lcolor.a="0.8"
							hlcolor.a="0.8"
							rcolor.a="0.8"
							hrcolor.a="0.8"
							color="graph_marker_cycle"
							hcolor="graph_marker_cycle"
							lcolor="graph_marker_cycle"
							hlcolor="graph_marker_cycle"
							rcolor="graph_marker_cycle"
							hrcolor="graph_marker_cycle">
							<marker v="10" color.hue=":hue_0" hcolor.hue=":hue_0" rborder="16" rcolor.hue=":hue_0" hrborder="16" hrcolor.hue=":hue_0"/>
							<marker id="fre_0" color.hue=":hue_0" hcolor.hue=":hue_0" lborder="16" lcolor.hue=":hue_0" hlborder="16" hlcolor.hue=":hue_0"/>
							<ui:for id="i" first="1" last="7">
								<marker id="sf_${i}" ui:id="split_marker_${i}" visibility=":cbe_${i}" editable="true" color.hue=":hue_${i}" hcolor.hue=":hue_${i}" rborder="16" rcolor.hue=":hue_${i}" hrborder="16" hrcolor.hue=":hue_${i}" pointer="hsize"/>
								<marker id="fre_${i}" visibility=":cbe_${i}" color.hue=":hue_${i}" hcolor.hue=":hue_${i}" lborder="16" lcolor.hue=":hue_${i}" hlborder="16" hlcolor.hue=":hue_${i}"/>
							</ui:for>
						</ui:with>
						
						<!-- Sidechain pre-equalization markers -->
						<marker id="hpf_f" ox="0" oy="1" color="graph_marker_cycle" color.hue="0.0" color.a="0.5" visibility=":hpf_s igt 0"/>
						<marker id="pk1_f" ox="0" oy="1" color="graph_marker_cycle" color.hue="0.25" color.a="0.5" visibility=":pk1_on"/>
						<marker id="pk1_g" ox="1" oy="0" color="graph_marker_cycle" color.hue="0.25" color.a="0.5" visibility=":pk1_on"/>
						<marker id="pk2_f" ox="0" oy="1" color="graph_marker_cycle" color.hue="0.5" color.a="0.5" visibility=":pk2_on"/>
						<marker id="pk2_g" ox="1" oy="0" color="graph_marker_cycle" color.hue="0.5" color.a="0.5" visibility=":pk2_on"/>
						<marker id="lpf_f" ox="0" oy="1" color="graph_marker_cycle" color.hue="0.75" color.a="0.5" visibility=":lpf_s igt 0"/>
	
						<!-- Analysis meshes -->
						<ui:if test=":mono">
							<mesh
								id="fftg" xi="0" yi="1"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="0"
								color="mono_in" color.a="0.8"
								fcolor="mono_in" fcolor.a="0.8" fill="true"
								visibility=":ife" />
							<mesh
								id="fftg" xi="0" yi="2"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="2"
								color="sidechain" color.a="0.8"
								visibility=":sfe" />
							<mesh
								id="fftg" xi="0" yi="3"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="2"
								color="mono"
								visibility=":ofe" />
						</ui:if>
						<ui:if test=":stereo">
							<mesh
								id="fftg" xi="0" yi="1"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="0"
								color="left_in" color.a="0.8"
								fcolor="left_in" fcolor.a="0.8" fill="true"
								visibility=":ife_l" />
							<mesh
								id="fftg" xi="0" yi="2"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="2"
								color="sidechain_1" color.a="0.8"
								visibility=":sfe_l" />
							<mesh
								id="fftg" xi="0" yi="3"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="2"
								color="left"
								visibility=":ofe_l" />
							<mesh
								id="fftg" xi="0" yi="4"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="0"
								color="right_in" color.a="0.8"
								fcolor="right_in" fcolor.a="0.8" fill="true"
								visibility=":ife_l" />
							<mesh
								id="fftg" xi="0" yi="5"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="2"
								color="sidechain_2" color.a="0.8"
								visibility=":sfe_l" />
							<mesh
								id="fftg" xi="0" yi="6"
								oy=":_ui_zoomable_spectrum_graph ? 1 : 3"
								width="2"
								color="right"
								visibility=":ofe_l" />
						</ui:if>
							
						<mesh id="ifg_r" oy=":_ui_zoomable_spectrum_graph ? 1 : 3" width="0" color="right_in" color.a="0.8" fcolor.a="0.8" fill="true" fcolor="right_in" visibility=":ife_r"/>
						<mesh id="ofg_l" oy=":_ui_zoomable_spectrum_graph ? 1 : 3" width="2" color="left" visibility=":ofe_l"/>
						<mesh id="ofg_r" oy=":_ui_zoomable_spectrum_graph ? 1 : 3" width="2" color="right" visibility=":ofe_r"/>
	
						<!-- Sidechain pre-equalization meshes -->
						<mesh
							id="sceq"
							xi="0" yi="3" width="2"
							color="graph_mesh_cycle" color.hue="0.0" color.a="0.3" smooth="true"
							fcolor="graph_mesh_cycle" fcolor.hue="0.0" fcolor.a="0.9" fill="true"
							visibility=":hpf_s igt 0" />
						<mesh
							id="sceq"
							xi="0" yi="1" width="2"
							color="graph_mesh_cycle" color.hue="0.25" color.a="0.3" smooth="true"
							fcolor="graph_mesh_cycle" fcolor.hue="0.25" fcolor.a="0.9" fill="true"
							visibility=":pk1_on" />
						<mesh
							id="sceq"
							xi="0" yi="2" width="2"
							color="graph_mesh_cycle" color.hue="0.5" color.a="0.3" smooth="true"
							fcolor="graph_mesh_cycle" fcolor.hue="0.5" fcolor.a="0.9" fill="true"
							visibility=":pk2_on" />	
						<mesh
							id="sceq"
							xi="0" yi="4" width="2"
							color="graph_mesh_cycle" color.hue="0.75" color.a="0.3" smooth="true"
							fcolor="graph_mesh_cycle" fcolor.hue="0.75" fcolor.a="0.9" fill="true"
							visibility=":lpf_s igt 0" />
						<mesh
							id="sceq"
							xi="0" yi="5" width="3"
							color="bright_cyan" smooth="true" />
							
						<!-- Crossover Meshes -->
						<mesh
							id="rgain"
							xi="0" yi="1" width="3"
							color="bright_cyan" smooth="true"
							fcolor="bright_cyan" fcolor.a="0.9" fill="true"
							visibility="(${mono}) or (!:ssplit)" />
						
						<ui:if test=":stereo">
							<mesh
								id="rgain"
								xi="0" yi="1" width="3"
								color="left" smooth="true"
								fcolor="left" fcolor.a="0.9" fill="true"
								visibility=":ssplit" />
							<mesh
								id="rgain"
								xi="0" yi="2" width="3"
								color="right" smooth="true"
								fcolor="right" fcolor.a="0.9" fill="true"
								visibility=":ssplit" />
						</ui:if>
							
						<!-- Axis -->
						<axis min="10" max="24000" angle="0.0" log="true" visibility="false"/>
						<axis min="-72 db / (:zoom ** 3)" max="24 db * :zoom" color="graph_prim" angle="0.5" log="true"/>
						<axis min="-1" max="1" visibility="false" angle="0.5"/>
						<axis min="-72 db" max="24 db" color="graph_prim" angle="0.5" log="true" visibility="false"/>
						<axis min="0" max=":_a_scaled_height" visibility="false" angle="0.5"/>
	
						<!-- Sidechain pre-equalization dots -->
						<ui:with
							pointer="drag"
							color="graph_marker_cycle" hover.color="graph_marker_cycle"
							bcolor="graph_marker_cycle" hover.bcolor="graph_marker_cycle"
							x.editable="true" y.editable="true" z.editable="true"
							x.astep="1" y.astep="1" >
							<dot
								ui:id="filter_dot_0"
								x.id="hpf_f"
								y="1"
								z.id="hpf_q"
								y.editable="false"
								size="1 + 2*:_ui_filter_point_thickness"
								hover.size="1 + 2*:_ui_filter_point_thickness"
								color.hue="0.0" hover.color.hue="0.0"
								bcolor.hue="0.0" hover.bcolor.hue="0.0"
								visibility=":hpf_s igt 0" />
							<dot
								ui:id="filter_dot_1"
								x.id="pk1_f"
								y.id="pk1_g"
								z.id="pk1_q"
								size="1 + 2*:_ui_filter_point_thickness"
								hover.size="1 + 2*:_ui_filter_point_thickness"
								color.hue="0.25" hover.color.hue="0.25"
								bcolor.hue="0.25" hover.bcolor.hue="0.25"
								visibility=":pk1_on" />
							<dot
								ui:id="filter_dot_2"
								x.id="pk2_f"
								y.id="pk2_g"
								z.id="pk2_q"
								size="1 + 2*:_ui_filter_point_thickness"
								hover.size="1 + 2*:_ui_filter_point_thickness"
								color.hue="0.5" hover.color.hue="0.5"
								bcolor.hue="0.5" hover.bcolor.hue="0.5"
								visibility=":pk2_on" />
							<dot
								ui:id="filter_dot_3"
								x.id="lpf_f"
								y="1"
								z.id="lpf_q"
								y.editable="false"
								size="1 + 2*:_ui_filter_point_thickness"
								hover.size="1 + 2*:_ui_filter_point_thickness"
								color.hue="0.75" hover.color.hue="0.75"
								bcolor.hue="0.75" hover.bcolor.hue="0.75"
								visibility=":lpf_s igt 0" />
						</ui:with>
	
						<!-- Text -->
						<ui:with ox="0" oy="2" y="0" halign="1" valign="1">
							<text x="10" text="graph.units.hz"/>
							<text x="20" text="20"/>
							<text x="30" text="30"/>
							<text x="50" text="50"/>
							<text x="100" text="100"/>
							<text x="200" text="200"/>
							<text x="300" text="300"/>
							<text x="500" text="500"/>
							<text x="1000" text="graph.values.x_k" text:value="1"/>
							<text x="2000" text="graph.values.x_k" text:value="2"/>
							<text x="3000" text="graph.values.x_k" text:value="3"/>
							<text x="5000" text="graph.values.x_k" text:value="5"/>
							<text x="10000" text="graph.values.x_k" text:value="10"/>
							<text x="20000" text="graph.values.x_k" text:value="20"/>
						</ui:with>
	
						<ui:with x="10" halign="1" valign="1">
							<ui:for id="g" first="-60" last="12" step="12">
								<text y="${g} db" text="${g}"/>
							</ui:for>
							<text y="0 db" ox="0" oy="2" text="graph.units.db" valign="-1"/>
							<ui:for id="g" first="-42" last="6" step="12">
								<text y="${g} db" text="${g}" visibility=":zoom le -9 db"/>
							</ui:for>
							<ui:for id="g" first="-21" last="3" step="6">
								<text y="${g} db" text="${g}" visibility=":zoom le -15 db"/>
							</ui:for>
						</ui:with>
	
						<ui:for id="i" first="1" last="7">
							<ui:with ox="0" oy="2" y="1" valign="-1" color="graph_marker_cycle" visibility="false" pad.h="4" font.bold="true">
								<text ui:id="split_note_${i}" x=":sf_${i}" halign="(:sf_${i} lt 500) ? 1 : -1" text.halign="(:sf_${i} lt 500) ? -1 : 1" color.hue="${(:i-1) * 0.125}"/>
							</ui:with>
						</ui:for>
					</graph>
				</group>

				<void bg.color="bg" vexpand="false" fill="false" pad.v="2"/>
				<hbox spacing="4" vexpand="false" bg.color="bg_schema" pad.h="6">
					<label text="labels.split"/>
					<combo id="split" pad.r="8" pad.v="4"/>
					<combo id="slope" pad.r="8" pad.v="4" activity=":split igt 0" />
					<void hexpand="true"/>
					<ui:if test=":stereo">
						<button id="ssplit" text="labels.stereo_split" size="22" ui:inject="Button_blue" pad.h="2"/>
					</ui:if>
					<vsep pad.h="2" bg.color="bg" reduce="true"/>
					<shmlink id="link" pad.l="2"/>
				</hbox>
			</vbox>

			<cell rows="2">
				<vbox vexpand="true" bg.color="bg_schema">
					<label font.name="lsp-icons" font.size="12" font.antialias="true" text="icons.main.zoom" color="text_icon" pad.b="4" pad.t="4"/>
					<fader id="zoom" angle="1" vexpand="true" bg.inherit="true" flat="true"/>
					<value id="zoom" width="40"/>
				</vbox>
			</cell>

			<grid rows="2" cols="1" hfill="false" hspacing="4" hexpand="false">
				<ui:with bg.color="bg_schema">
					<label text="labels.gain_" width.min="24" padding="4"/>
				</ui:with>

				<!-- Gain signal meter -->
				<ledmeter vexpand="true" height.min="256" angle="1">
					<ui:if test=":mono">
						<ledchannel
							id="rlm"
							min="-48 db" max="48 db" log="true"
							balance="0 db" balance.visibility="true"
							type="peak" value.color="blue" />
					</ui:if>
					<ui:if test=":stereo">
						<ledchannel
							id="rlm_l"
							min="-48 db" max="48 db" log="true"
							balance="0 db" balance.visibility="true"
							type="peak" value.color="blue" />
						<ledchannel
							id="rlm_r"
							min="-48 db" max="48 db" log="true"
							balance="0 db" balance.visibility="true"
							type="peak" value.color="blue" />
					</ui:if>
				</ledmeter>
			</grid>

			<vbox expand="true">
				<group ui:inject="GraphGroup" ipadding="0" expand="true" fill="true" text="labels.graphs.reduction">
					<!-- Curve graph -->
					<graph width.min="256" height.min="256" expand="true" fill="true">
						<origin hpos="-1" vpos="-1" visible="false"/>

						<!-- Gray grid -->
						<ui:for id="g" first="-60" last="12" step="24">
							<marker v="${g} db" color="graph_alt_1"/>
							<marker v="${g} db" ox="1" oy="0" color="graph_alt_1"/>
						</ui:for>

						<!-- Yellow grid -->
						<ui:for id="g" first="-48" last="-24" step="24">
							<marker v="${g} db" color="graph_sec"/>
							<marker v="${g} db" ox="1" oy="0" color="graph_sec"/>
						</ui:for>

						<!-- Axes and boundaries -->
						<marker v="1" ox="1" oy="0" dv="1" dx=":_a_width" dy=":_a_height" color="graph_alt_1" width="2" smooth="true"/>
						<marker v="24 db" color="graph_alt_1" visibility="false"/>
						<marker v="24 db" ox="1" oy="0" color="graph_alt_1" visibility="false"/>
						<axis min="-72 db" max="24 db" color="graph_prim" angle="0.0" log="true" visibility="false"/>
						<axis min="-72 db" max="24 db" color="graph_prim" angle="0.5" log="true" visibility="false"/>

						<!-- 0 dB markers -->
						<marker v="0 db" ox="0" oy="1" width="2" color="graph_prim"/>
						<marker v="0 db" ox="1" oy="0" width="2" color="graph_prim"/>

						<!-- Meshes -->
						<mesh id="curve" width="3" color="graph_mesh" smooth="true"/>

						<!-- Markers -->
						<marker id="thresh" editable="true" width="2" pointer="hsize" color="threshold" hcolor="threshold"/>

						<!-- Text -->
						<text x="0 db" y="0 db" text="0" halign="1" valign="1"/>
						<ui:attributes x="0 db" halign="1" valign="-1">
							<text y="24 db" text="graph.units.db"/>
							<text y="12 db" text="+12"/>
							<text y="-12 db" text="-12"/>
							<text y="-24 db" text="-24"/>
							<text y="-36 db" text="-36"/>
							<text y="-48 db" text="-48"/>
							<text y="-60 db" text="-60"/>
							<text y="-72 db" text="graph.axis.out" valign="1"/>
						</ui:attributes>
						<ui:attributes y="0 db" halign="-1" valign="1">
							<text x="24 db" text="graph.units.db"/>
							<text x="12 db" text="+12"/>
							<text x="-12 db" text="-12"/>
							<text x="-24 db" text="-24"/>
							<text x="-36 db" text="-36"/>
							<text x="-48 db" text="-48"/>
							<text x="-60 db" text="-60"/>
							<text x="-72 db" text="graph.axis.in" halign="1"/>
						</ui:attributes>
					</graph>
				</group>
				<void bg.color="bg" vexpand="false" fill="false" pad.v="2"/>
				<hbox spacing="4" vexpand="false" bg.color="bg_schema" pad.h="6">
					<button ui:id="premix_trigger" id="showpmx" text="labels.premix" size="22" pad.v="4"/>
					<button ui:id="sidechain_trigger" id="showsc" text="labels.sidechain" size="22" pad.v="4"/>
				</hbox>
			</vbox>

			<grid rows="2" cols="2" hfill="false" hexpand="false" hspacing="4">
				<ui:with bg.color="bg_schema">
					<label text="labels.chan.in" padding="4" width.min="24"/>
					<label text="labels.chan.out" padding="4" width.min="24"/>
				</ui:with>

				<!-- Input signal meter -->
				<ledmeter vexpand="true" height.min="256" angle="1">
					<ui:if test=":mono">
						<ledchannel
							id="ilm"
							min="-72 db" max="24 db" log="true"
							type="rms_peak" peak.visibility="true"
							value.color="mono_in" />
					</ui:if>
					<ui:if test=":stereo">
						<ledchannel
							id="ilm_l"
							min="-72 db" max="24 db" log="true"
							type="rms_peak" peak.visibility="true"
							value.color="left_in" />
						<ledchannel
							id="ilm_r"
							min="-72 db" max="24 db" log="true"
							type="rms_peak" peak.visibility="true"
							value.color="right_in" />
					</ui:if>
				</ledmeter>

				<!-- Output signal meter -->
				<ledmeter vexpand="true" height.min="256" angle="1">
					<ui:if test=":mono">
						<ledchannel
							id="olm"
							min="-72 db" max="24 db" log="true"
							type="rms_peak" peak.visibility="true"
							value.color="mono" />
					</ui:if>
					<ui:if test=":stereo">
						<ledchannel
							id="olm_l"
							min="-72 db" max="24 db" log="true"
							type="rms_peak" peak.visibility="true"
							value.color="left" />
						<ledchannel
							id="olm_r"
							min="-72 db" max="24 db" log="true"
							type="rms_peak" peak.visibility="true"
							value.color="right" />
					</ui:if>
				</ledmeter>
			</grid>
		
			<vbox spacing="4">
				<group text="groups.signal" expand="true">
					<grid rows="5" cols="2" hspacing="4">
						<knob id="g_in" pad.r="4"/>
						<vbox vfill="false">
							<label text="labels.input" halign="0"/>
							<value id="g_in" sline="true" halign="0"/>
						</vbox>

						<knob id="g_out" pad.r="4"/>
						<vbox vfill="false">
							<label text="labels.output" expand="true" halign="0"/>
							<value id="g_out" width.min="50" sline="true" halign="0"/>
						</vbox>
					</grid>
				</group>

				<!-- Analysis -->
				<group text="groups.analysis" expand="true" ipadding="0">
					<vbox>
						<ui:if test=":mono">
							<vbox>
								<button id="ife" text="labels.fft.fft_in" height="19" width="30" ui:inject="Button_mono_8"/>
								<button id="sfe" text="labels.fft.fft_sc" height="19" width="30" ui:inject="Button_mono_8"/>
								<button id="ofe" text="labels.fft.fft_out" height="19" width="30" ui:inject="Button_mono_8"/>

								<hsep pad.v="2" bg.color="bg" vreduce="true"/>
							</vbox>
						</ui:if>
						
						<ui:if test=":stereo">
							<grid rows="6" cols="2">
								<align halign="-1" pad.t="4" pad.l="6">
									<label text="labels.fft.fft_in"/>
								</align>
								<hbox spacing="4" pad.v="4" pad.h="6" hfill="false">
									<button id="ife_l" text="labels.chan.L_eft" size="19" ui:inject="Button_left_8"/>
									<button id="ife_r" text="labels.chan.R_ight" size="19" ui:inject="Button_right_8"/>
								</hbox>
								
								<cell cols="2"><hsep pad.v="2" bg.color="bg" vreduce="true"/></cell>
	
								<align halign="-1" pad.t="4" pad.l="6">
									<label text="labels.fft.fft_sc" halign="0"/>
								</align>
								<hbox spacing="4" pad.v="4" pad.h="6" hfill="false">
									<button id="sfe_l" text="labels.chan.L_eft" size="19" ui:inject="Button_left_8"/>
									<button id="sfe_r" text="labels.chan.R_ight" size="19" ui:inject="Button_right_8"/>
								</hbox>
	
								<cell cols="2"><hsep pad.v="2" bg.color="bg" vreduce="true"/></cell>
	
								<align halign="-1" pad.t="4" pad.l="6">
									<label text="labels.fft.fft_out" halign="0"/>
								</align>
								<hbox spacing="4" pad.v="4" pad.h="6" hfill="false">
									<button id="ofe_l" text="labels.chan.L_eft" size="19" ui:inject="Button_left_8"/>
									<button id="ofe_r" text="labels.chan.R_ight" size="19" ui:inject="Button_right_8"/>
								</hbox>
								
								<cell cols="2"><hsep pad.v="2" bg.color="bg" vreduce="true"/></cell>
							</grid>
						</ui:if>

						<grid rows="2" cols="2" transpose="false" expand="true" hspacing="4">
							<knob id="react" size="20" pad.r="4" pad.l="6"/>
							<vbox vfill="false" pad.r="6">
								<label text="labels.metering.reactivity" halign="0"/>
								<value id="react" width.min="50" sline="true" halign="0"/>
							</vbox>

							<knob id="shift" size="20" pad.r="4" pad.l="6"/>
							<vbox vfill="false" pad.r="6">
								<label text="labels.metering.shift" halign="0"/>
								<value id="shift" width.min="50" sline="true" halign="0"/>
							</vbox>
						</grid>
					</vbox>
				</group>
			</vbox>
		</hbox>

		<!-- Separator -->
		<void bg.color="bg" fill="true" pad.v="2" reduce="true"/>

		<!-- Bottom part -->
		<hbox>
			<group text="groups.plug.deesser" vexpand="false" hexpand="true" ipadding="0">
				<grid rows="3" cols="6">
					<label text="labels.thresh_old" />
					<label text="labels.attack" />
					<label text="labels.release" />
					<label text="labels.hold" />
					<label text="labels.ratio" />
					<label text="labels.knee" />
					
					<knob id="thresh" />
					<knob id="att" />
					<knob id="rel" />
					<knob id="hold" />
					<knob id="ratio" />
					<knob id="knee" />
					
					<value id="thresh" />
					<value id="att" />
					<value id="rel" />
					<value id="hold" />
					<value id="ratio" />
					<value id="knee" />
				</grid>
			</group>
			
			<group text="groups.pre_equalization" vexpand="false" hexpand="true" ipadding="0">
				<grid rows="4" cols="10">
					<!-- Row 1 -->
					<cell cols="2">
						<hbox>
							<label text="labels.flt.HPF" />
							<combo id="hpf_s" />
						</hbox>
					</cell>
					<cell cols="3">
						<button id="pk1_on" text="labels.flt.peak_1" />
					</cell>
					<cell cols="3">
						<button id="pk2_on" text="labels.flt.peak_2" />
					</cell>
					<cell cols="2">
						<hbox>
							<label text="labels.flt.LPF" />
							<combo id="lpf_s" />
						</hbox>
					</cell>
					
					<!-- Row 2 -->
					<label text="labels.freq" />
					<label text="labels.q" />
					
					<label text="labels.freq" />
					<label text="labels.q" />
					<label text="labels.gain" />
					
					<label text="labels.freq" />
					<label text="labels.q" />
					<label text="labels.gain" />
					
					<label text="labels.freq" />
					<label text="labels.q" />
					
					<!-- Row 3 -->
					<knob id="hpf_f" />
					<knob id="hpf_q" />
					
					<knob id="pk1_f" />
					<knob id="pk1_q" />
					<knob id="pk1_g" />
					
					<knob id="pk2_f" />
					<knob id="pk2_q" />
					<knob id="pk2_g" />
					
					<knob id="lpf_f" />
					<knob id="lpf_q" />
					
					<!-- Row 4 -->
					<value id="hpf_f" />
					<value id="hpf_q" />
					
					<value id="pk1_f" />
					<value id="pk1_q" />
					<value id="pk1_g" />
					
					<value id="pk2_f" />
					<value id="pk2_q" />
					<value id="pk2_g" />
					
					<value id="lpf_f" />
					<value id="lpf_q" />
				</grid>
			</group>

			<!-- Separator -->
			<vsep bg.color="bg" pad.h="2" hreduce="true"/>
		</hbox>

	</vbox>

	<!-- Premix overlay -->
	<overlay id="showpmx" trigger="premix_trigger" hpos="1" vpos="1" halign="-1" valign="1" ipadding.t="4">
		<group text="groups.premix" vexpand="false" ipadding="0">
			<grid rows="3" cols="${(:is_sidechain) ? 8 : 5}" spacing="0" bg.color="bg_schema" transpose="true" height="139">
				<ui:if test=":is_sidechain">
					<label text="labels.premix.in_to_sc" pad.h="6" pad.v="4" />
					<knob id="in2sc" />
					<value id="in2sc" pad.h="6" pad.v="4" />
				</ui:if>

				<label text="labels.premix.in_to_link" pad.h="6" pad.v="4" />
				<knob id="in2lk" />
				<value id="in2lk" />

				<cell rows="3"><vsep pad.h="2" bg.color="bg" reduce="true" /></cell>

				<ui:if test=":is_sidechain">
					<label text="labels.premix.sc_to_in" pad.h="6" pad.v="4" />
					<knob id="sc2in" />
					<value id="sc2in" pad.h="6" pad.v="4" />

					<label text="labels.premix.sc_to_link" pad.h="6" pad.v="4" />
					<knob id="sc2lk" />
					<value id="sc2lk" pad.h="6" pad.v="4" />

					<cell rows="3"><vsep pad.h="2" bg.color="bg" reduce="true" /></cell>
				</ui:if>

				<label text="labels.premix.link_to_in" pad.h="6" pad.v="4" />
				<knob id="lk2in" />
				<value id="lk2in" pad.h="6" pad.v="4" />

				<label text="labels.premix.link_to_sc" pad.h="6" pad.v="4" />
				<knob id="lk2sc" />
				<value id="lk2sc" pad.h="6" pad.v="4" />
			</grid>
		</group>
	</overlay>

	<!-- Sidechain overlay -->
	<overlay id="showsc" trigger="sidechain_trigger" hpos="1" vpos="1" halign="-1" valign="1" ipadding.t="4">
		<group text="groups.sidechain" vexpand="false" ipadding="0">
			<grid rows="5" cols="9" spacing="0" bg.color="bg_schema" height="139">
				<!-- row 1 -->
				<ui:with pad.h="6" pad.v="4" fill="false" hexpand="true" width.min="56">
					<label text="labels.sc.preamp" vreduce="true"/>
					<label text="labels.sc.reactivity" vreduce="true"/>
					<label text="labels.sc.lookahead" vreduce="true"/>
				</ui:with>
				<cell rows="5" bg.color="bg" pad.h="2" hreduce="true"><vsep/></cell>
				<label text="labels.setup" pad.h="6" pad.v="4" fill="false" vreduce="true"/>
				<cell rows="5" bg.color="bg" pad.h="2" hreduce="true"><vsep/></cell>
				<label text="labels.flt.HPF" pad.h="6" pad.v="4" fill="false" vreduce="true"/>
				<cell rows="5" bg.color="bg" pad.h="2" hreduce="true"><vsep/></cell>
				<label text="labels.flt.LPF" pad.h="6" pad.v="4" fill="false" vreduce="true"/>

				<!-- row 2 -->
				<ui:with bg.color="bg" pad.v="2" vreduce="true">
					<cell cols="3"><hsep/></cell>
					<hsep/>
					<hsep/>
					<hsep/>
				</ui:with>

				<!-- row 3 -->
				<cell rows="2"><knob id="scp" scolor="kscale"/></cell>
				<cell rows="2"><knob id="scr" scolor="kscale"/></cell>
				<cell rows="2"><knob id="sla" scolor="kscale"/></cell>
				<cell rows="3">
					<vbox fill="false" spacing="1">
						<ui:with pad.h="6" pad.b="4" hfill="true">
							<combo id="sct" pad.t="4"/>
							<combo id="scm"/>
							<ui:if test=":stereo">
								<combo id="scs" visibility="!:ssplit"/>
								<combo id="sscs" visibility=":ssplit"/>
							</ui:if>
							<button id="scl" height="22" text="labels.listen" ui:inject="Button_cyan"/>
						</ui:with>
					</vbox>
				</cell>
				<combo id="shpm" pad.h="6" bright="(:shpm igt 0) ? 1 : 0.75" bg.bright="(:shpm igt 0) ? 1 : :const_bg_darken"/>
				<combo id="slpm" pad.h="6" bright="(:slpm igt 0) ? 1 : 0.75" bg.bright="(:slpm igt 0) ? 1 : :const_bg_darken"/>

				<!-- row 4 -->
				<knob id="shpf" size="20" scolor="(:shpm igt 0) ? 'kscale' : 'cycle_inactive'" bg.bright="(:shpm igt 0) ? 1 : :const_bg_darken"/>
				<knob id="slpf" size="20" scolor="(:slpm igt 0) ? 'kscale' : 'cycle_inactive'" bg.bright="(:slpm igt 0) ? 1 : :const_bg_darken"/>

				<!-- row 5 -->
				<value id="scp" sline="true" width.min="48"/>
				<value id="scr" sline="true"/>
				<value id="sla" sline="true"/>
				<value id="shpf" sline="true" bright="(:shpm igt 0) ? 1 : 0.75" bg.bright="(:shpm igt 0) ? 1 : :const_bg_darken"/>
				<value id="slpf" sline="true" bright="(:slpm igt 0) ? 1 : 0.75" bg.bright="(:slpm igt 0) ? 1 : :const_bg_darken"/>
			</grid>
		</group>
	</overlay>
	
</plugin>
